rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada pessoa só acessa as próprias notas, e toda nota gravada precisa ter
    // o formato que o app (app.js) realmente envia. Isso impede que alguém com
    // a sessão aberta (ou um bug) grave lixo, campos extras ou documentos gigantes.
    match /users/{userId}/notes/{noteId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Campos comuns a criar e editar. "content" é o campo antigo (nota de
      // página única) e só é aceito como texto.
      function validNote() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'pages', 'date', 'attachments', 'createdAt', 'updatedAt', 'content'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 300
          && d.pages is list && d.pages.size() >= 1 && d.pages.size() <= 100
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.attachments is list && d.attachments.size() <= 5
          && d.updatedAt == request.time
          && (!('content' in d) || d.content is string);
      }

      allow read, delete: if isOwner();

      // Criar: createdAt é obrigatório e vem do servidor.
      allow create: if isOwner() && validNote()
        && request.resource.data.createdAt == request.time;

      // Editar: createdAt não pode mudar depois de criado.
      allow update: if isOwner() && validNote()
        && (resource.data.get('createdAt', null) == request.resource.data.get('createdAt', null));
    }
  }
}
